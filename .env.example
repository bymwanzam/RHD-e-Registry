# RHD e-Registry settings (optional).
# The easiest way to connect the database is the set-up page the website shows on first start.
# Alternatively, enter these in cPanel → Setup Python App → Environment variables, or copy this
# file to ".env" in the app folder and fill it in. Restart the app after changes.

# ---- Database: MySQL / MariaDB (created in cPanel → MySQL Databases) ----
# DB_CLIENT=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=cpaneluser_eregistry
# DB_USER=cpaneluser_eregadmin
# DB_PASSWORD="change-me"

# ---- Set-up key (optional: your own key for the set-up page, at least 8 characters) ----
# SETUP_KEY=Ghana-RHD-2026

# ---- Address of the system (used for links in SMS alerts) ----
APP_URL=https://e-registry.rhduer.online

# ---- Security ----
COOKIE_SECURE=1
# ALLOWED_HOSTS=e-registry.rhduer.online

# ---- Optional ----
# LETSFISH_APP_ID=
# LETSFISH_APP_SECRET=
# DATA_DIR=/home/cpaneluser/rhd-e-registry-data
